# fixture = offline replay, openai = live Chat Completions API
VERITY_MODEL_PROVIDER=fixture
VERITY_MODEL=gpt-5-nano
VERITY_MODEL_TEMPERATURE=1
VERITY_MODEL_API_KEY=
# VERITY_MODEL_BASE_URL=https://your-gateway.example/v1
VERITY_COST_PER_1K_IN=0.00005
VERITY_COST_PER_1K_OUT=0.0004
# VERITY_TRACE_INGEST_URL=
# VERITY_TRACE_API_KEY=

# --- Neatlogs: independent observability layer -------------------------------
# One worker run is posted as one nested trace when this key is present.
# Ingest-only write key (nlw_...) from the Neatlogs dashboard.
NEATLOGS_API_KEY=
NEATLOGS_PROJECT=verity
# NEATLOGS_ENDPOINT=https://ingest.neatlogs.com/v1/trace

# --- TensorMux: inference routing --------------------------------------------
# TensorMux is an OpenAI-compatible gateway, so it needs no code: point the
# model base URL at it and keep VERITY_MODEL_PROVIDER=openai. Routing, metering
# and audit logs then happen at the gateway.
# VERITY_MODEL_BASE_URL=http://localhost:8080/v1

# --- Dodo Payments: settlement ingestion (READ ONLY) --------------------------
# Lists payouts and maps settled ones to bank lines for reconciliation.
# Nothing in this codebase creates, refunds or moves a payment.
DODO_API_KEY=
DODO_MODE=test
# Live mode is double-gated. Both of these are required to read live data:
# DODO_MODE=live
# DODO_ALLOW_LIVE=true
