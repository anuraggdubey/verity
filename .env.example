# Model provider for the finance worker.
#   fixture = replay a recorded transcript, no network, no key (default)
#   openai  = live model through the OpenAI SDK, or any OpenAI-compatible
#             endpoint via VERITY_MODEL_BASE_URL (this is where a router such as
#             TensorMux would be wired in)
VERITY_MODEL_PROVIDER=fixture
VERITY_MODEL=gpt-4o-mini
VERITY_MODEL_TEMPERATURE=0
VERITY_MODEL_API_KEY=
# VERITY_MODEL_BASE_URL=https://your-gateway.example/v1

# Cost accounting. Left unset, every run reports $0.00 rather than a number
# nobody can defend. Set these to your provider's actual prices.
VERITY_COST_PER_1K_IN=0
VERITY_COST_PER_1K_OUT=0

# Trace sink (Neatlogs or any HTTP collector). Both must be set or tracing stays
# in-process. Confirm the URL and payload shape against the vendor's own docs
# before relying on it — see src/lib/trace/neatlogs.ts.
# VERITY_TRACE_INGEST_URL=
# VERITY_TRACE_API_KEY=
